{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile --filter code-reviewer-app...",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/webhooks/**/route.ts": { "maxDuration": 60 },
    "src/app/api/runners/**/route.ts": { "maxDuration": 60 },
    "src/app/api/workers/**/route.ts": { "maxDuration": 60 },
    "src/app/api/w/**/route.ts": { "maxDuration": 60 },
    "src/app/api/internal/**/route.ts": { "maxDuration": 300 },
    "src/app/api/instance-portal/catalog-fetch/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/internal/repository-sync", "schedule": "17 3 * * *" },
    { "path": "/api/internal/dispatch-sweep", "schedule": "0 */2 * * *" },
    { "path": "/api/internal/tracker-resync", "schedule": "43 3 * * *" }
  ]
}
