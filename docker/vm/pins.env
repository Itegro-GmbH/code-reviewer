# What the local VM artifacts (#976) download, pinned by version AND sha256: a script refuses a file with another checksum.
# Docker, buildx and Sysbox are not here: they are the golden snapshot's pins (dispatcher/src/snapshot/config.ts), read through
# dispatcher/src/vm-artifacts/recipe.ts, so the hosted snapshot and the local root file system cannot drift apart.
# Where a checksum came from is written next to it; each was compared with the publisher's own list on 2026-11-10.

# Firecracker release tarball (x86_64): the checksum of the release's own .sha256.txt. The VM artifacts' smoke boot runs on it, and the program release (runner/release/build_program.py) ships this very binary, so there is one pin.
FIRECRACKER_VERSION=1.17.0
FIRECRACKER_URL=https://github.com/firecracker-microvm/firecracker/releases/download/v1.17.0/firecracker-v1.17.0-x86_64.tgz
FIRECRACKER_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558

# Firecracker's recommended guest config for 6.18 (same tag): the base of our kernel configuration
FC_GUEST_CONFIG_URL=https://raw.githubusercontent.com/firecracker-microvm/firecracker/v1.17.0/resources/guest_configs/microvm-kernel-ci-x86_64-6.18.config
FC_GUEST_CONFIG_SHA256=ba22401a0c7292a4c024ebcd10a562d4a1f1bfd2faed671406d3b159c0cf5215

# Linux 6.18 LTS (the hosted VMs run 6.18.56); checksum from cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc
KERNEL_VERSION=6.18.62
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.62.tar.xz
KERNEL_SHA256=490a7aedf1b355c565d3a6c05333ccccb5da82064eca46b590448a7099d7d651

# Guest user space: Ubuntu Base 26.04.1 (the hosted golden snapshot's base image is 26.04.1); checksum from cdimage.ubuntu.com SHA256SUMS
UBUNTU_BASE_VERSION=26.04.1
UBUNTU_BASE_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/26.04/release/ubuntu-base-26.04.1-base-amd64.tar.gz
UBUNTU_BASE_SHA256=a496a960472ce474a59590b8987d3a1135d3cbef1991f3b1abe8cacfea8bf85a
