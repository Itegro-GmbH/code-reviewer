#!/bin/bash
# SPDX-License-Identifier: LicenseRef-Proprietary
#
# PID 1's child in the guest (the kernel starts `/usr/bin/docker-init` = tini, which reaps and runs this). The placeholder of #976 for the
# real vm-init (#977): the same order the hosted VM has, and enough of it for the build and the smoke boot. Mounts, the job disk (Docker's
# and Sysbox's state live on it), the cgroup layout, then the SAME two scripts the hosted VM runs: vm-prepare.sh (cgroups + dockerd) and
# sysbox-prepare.sh (the Sysbox daemons). It reports to the console as `VMINIT <name> uptime=<s> [key=value ...]`, one line each; #977
# reports the same milestones over vsock. The mode comes from the kernel command line, `vm.mode=`:
#   run    prepare, then wait (what a job's VM does until vm-init takes over)
#   seed   prepare, load the image archive of the second extra disk into Docker, stop Docker cleanly, power off (builds the data disk)
#   smoke  prepare, run the checks below, power off (the release's own test)
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin HOME=/root

say() {
  local name=$1
  shift
  printf 'VMINIT %s uptime=%s%s\n' "$name" "$(cut -d' ' -f1 /proc/uptime)" "${*:+ $*}" 2> /dev/null > /dev/console || true
}

# The end of a VM that nobody waits for: sync, then the guest reboots itself and Firecracker exits (`reboot=k`).
power_off() {
  sync
  echo 1 > /proc/sys/kernel/sysrq
  echo b > /proc/sysrq-trigger
  sleep 60
}

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t tmpfs tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=1777 tmpfs /var/tmp
mount -t tmpfs tmpfs /var/log
mount -t tmpfs tmpfs /var/cache
mount -t tmpfs -o mode=0700 tmpfs /root
mount -t cgroup2 none /sys/fs/cgroup

getarg() { tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p" | head -n 1; }
mode=$(getarg vm.mode)
mode=${mode:-run}

: > /run/resolv.conf
hostname code-reviewer-vm
ip link set lo up
say init_up mode="$mode"

# The job disk: Docker's state, the containerd image store and Sysbox's state live on it, bound to the places the daemons use. The hosted
# daemon.json is used as it is (no data-root): Docker 29's containerd image store ignores `data-root` and keeps its images under
# /var/lib/containerd, so the disk is mounted over the three default directories and nothing in the daemon's configuration differs.
mkdir -p /jobdisk
mount -t ext4 -o noatime /dev/vdb /jobdisk || { say disk_failed; power_off; }
for d in docker containerd sysbox; do
  mkdir -p "/jobdisk/$d" "/var/lib/$d"
  mount --bind "/jobdisk/$d" "/var/lib/$d"
done
# sysbox-fs mounts its FUSE file systems under /var/lib/sysboxfs and fails the container's pre-registration when it cannot create it
# ("FuseServer with invalid mountpoint"): on a read-only root file system the directory must exist and be writable.
mount -t tmpfs tmpfs /var/lib/sysboxfs
say disk_ready

# vm-prepare.sh (the hosted VM's script) starts by DISabling cpuset/cpu/pids in the root's subtree_control: it expects the layout the
# platform's init made. A kernel that starts with no controller enabled makes that write fail (EINVAL), so enable them first.
for controller in cpuset cpu io memory pids; do
  echo "+$controller" > /sys/fs/cgroup/cgroup.subtree_control || echo "vm-init: cgroup controller $controller cannot be enabled" >&2
done
if vm-prepare.sh; then say docker_ready; else say docker_failed; fi
if sysbox-prepare.sh; then say sysbox_ready; else say sysbox_failed; fi

recipe=/etc/code-reviewer-vm/recipe.json
worker_tag=$(jq -r .worker.tag "$recipe")
agent_tag=$(jq -r .agent.tag "$recipe")
image_id() { docker image inspect --format '{{.Id}}' "$1" 2> /dev/null; }

case "$mode" in
  seed)
    mkdir -p /seed
    if ! mount -t ext4 -o ro /dev/vdc /seed; then say seed_failed reason=no_seed_disk; power_off; fi
    if docker load --input /seed/images.tar > /run/docker-load.log 2>&1; then
      say images_loaded
    else
      say seed_failed reason=docker_load "tail=$(tail -n 3 /run/docker-load.log | tr '\n ' '|_')"
      power_off
    fi
    say image role=worker "tag=$worker_tag" "id=$(image_id "$worker_tag")"
    say image role=agent "tag=$agent_tag" "id=$(image_id "$agent_tag")"
    say store "driver=$(docker info --format '{{.Driver}}' 2> /dev/null)" "snapshotter=$(docker info --format '{{range .DriverStatus}}{{index . 1}}{{end}}' 2> /dev/null | tr ' ' '_')"
    # The daemon stops the way the golden snapshot's pipeline stops it before it snapshots: SIGTERM, then wait until it and containerd are gone.
    kill -TERM "$(pgrep -x dockerd)" 2> /dev/null
    for _ in $(seq 1 300); do
      pgrep -x 'dockerd|containerd|containerd-shim' > /dev/null || break
      sleep 0.2
    done
    if pgrep -x 'dockerd|containerd|containerd-shim' > /dev/null; then say seed_failed reason=daemon_not_stopped; power_off; fi
    sync
    umount /seed
    for d in sysbox containerd docker; do umount "/var/lib/$d"; done
    umount /jobdisk
    say seed_done
    power_off
    ;;
  smoke)
    ok=1
    check() {
      local name=$1
      shift
      if "$@" > "/run/check-$name.log" 2>&1; then
        say check name="$name" result=ok
      else
        say check name="$name" result=fail "tail=$(tail -n 3 "/run/check-$name.log" | tr '\n ' '|_')"
        ok=0
      fi
    }
    say store "driver=$(docker info --format '{{.Driver}}' 2> /dev/null)" "snapshotter=$(docker info --format '{{range .DriverStatus}}{{index . 1}}{{end}}' 2> /dev/null | tr ' ' '_')"
    say image role=worker "tag=$worker_tag" "id=$(image_id "$worker_tag")"
    say image role=agent "tag=$agent_tag" "id=$(image_id "$agent_tag")"
    check root_read_only bash -c '! touch /usr/local/sbin/.write-test'
    check runc_container docker run --rm --runtime=runc --network none --entrypoint true "$worker_tag"
    check sysbox_container docker run --rm --runtime=sysbox-runc --network none --entrypoint true "$agent_tag"
    # The golden snapshot's own self-check of the Worker image (`probe` mode, the hardened container flags): one JSON line, the verdict.
    if probe=$(/usr/local/share/code-reviewer-vm/check-worker-probe.sh 2> /run/check-probe.err); then
      say check name=worker_probe result=ok "output_b64=$(printf '%s' "$probe" | base64 -w0)"
    else
      say check name=worker_probe result=fail "tail=$(tail -n 3 /run/check-probe.err | tr '\n ' '|_')"
      ok=0
    fi
    say smoke_done "ok=$ok"
    power_off
    ;;
  *)
    say ready
    while :; do sleep 3600; done
    ;;
esac
