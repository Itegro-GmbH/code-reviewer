## What the Firecracker guest kernel (6.18 LTS) needs on top of Firecracker's recommended microvm config
## (microvm-kernel-ci-x86_64-6.18.config, tag v1.17.0) for Docker, Sysbox 0.7.1 and the VM's job (#976; found and measured by the spike #970).
## Lines starting with "##" are explanations. kernel/configure.sh merges this file with `merge_config.sh`, runs
## `make olddefconfig` and FAILS when one option below did not end up with the value given here (a silently
## dropped option is the usual failure of a hand-written fragment: an unmet dependency). `=n` means the option must not be set.

## --- introspection: Sysbox and Docker's check-config.sh read /proc/config.gz
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## --- namespaces and cgroup v2 (runc, Docker, Sysbox's nested containers)
CONFIG_NAMESPACES=y
CONFIG_TIME_NS=y
CONFIG_PROC_CHILDREN=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
## MUST be off: Firecracker's recommended config has RT_GROUP_SCHED=y, and with it enabling the `cpu` controller for child cgroups
## fails with EINVAL as long as a real-time kernel thread (migration/N, ksoftirqd) sits in the root cgroup. vm-prepare.sh (the
## hosted VM's cgroup script) then fails: "cgroup_root_busy ... Invalid argument", Docker never starts, Sysbox cannot start.
CONFIG_RT_GROUP_SCHED=n
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_MISC=y
## runc on cgroup v2 limits devices with a BPF program; sysbox-runc and runc need these
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
## Sysbox intercepts mount, umount, chown, ... with the seccomp "user notification" (SECCOMP_FILTER, 5.0+)
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_KEYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_MISC=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_EVENTFD=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

## --- file systems: overlayfs (Docker's overlay2, also inside a Sysbox container), ext4 for the disks, FUSE for sysbox-fs
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FUSE_FS=y
## sysbox-fs is a FUSE file system that emulates /proc and /sys inside the container: /dev/fuse is a must
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_XFS_FS=y

## --- network: veth, bridge, tun, netfilter (Docker's bridge network with NAT, Docker 29's nftables backend, iptables-nft)
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_TUN=y
CONFIG_DUMMY=y
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

## --- no 32-bit system calls (review of #977): Docker's default seccomp profile, which the agent's container gets, allows `socketcall`
## and denies AF_VSOCK only as an argument of `socket`. With IA32 or X32 emulation a 32-bit binary or `int 0x80` in that container
## could open a vsock socket to the host's ports 5100/5101. Without the emulation that path does not exist.
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n

## --- host <-> guest: vsock (the start payload and the exit report), virtio devices (Firecracker has no PCI)
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y
