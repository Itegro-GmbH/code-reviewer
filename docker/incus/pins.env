# What the Incus golden image (#1020) downloads, pinned by version AND sha256: build-golden.sh refuses a file with another checksum.
# Docker and buildx are the versions of the golden snapshot's pipeline (dispatcher/src/snapshot/config.ts: dockerVersion, buildxVersion) and of the
# Firecracker rootfs: the same engine on every backend. The static bundle is what the spikes (#970, #1005) ran.

# Docker's static bundle. Docker publishes no checksum list for it: this is the sha256 of the file fetched from download.docker.com on 2026-11-13.
DOCKER_VERSION=29.1.3
DOCKER_URL=https://download.docker.com/linux/static/stable/x86_64/docker-29.1.3.tgz
DOCKER_SHA256=c019c608ba2bb009dd673f3230e4d743f36a78d36166c6c2444c05d0aa9ff0d9

# buildx: the checksum of the release's own checksums.txt (compared on 2026-11-13).
BUILDX_VERSION=0.30.1
BUILDX_URL=https://github.com/docker/buildx/releases/download/v0.30.1/buildx-v0.30.1.linux-amd64
BUILDX_SHA256=c37114fcd034025ec68e224657c8a5a850df472ded3ddcbca75ad3a7ebb9710d
