# Spike #970: every downloaded artifact is pinned by version AND sha256. A script refuses a file whose checksum differs.
# Where a checksum came from is written next to it.

# Firecracker release tarball (x86_64): the checksum is the one of the release's own .sha256.txt and of the API's asset digest
FIRECRACKER_VERSION=1.17.0
FIRECRACKER_URL=https://github.com/firecracker-microvm/firecracker/releases/download/v1.17.0/firecracker-v1.17.0-x86_64.tgz
FIRECRACKER_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558

# Firecracker's recommended guest config for 6.18 (same tag), the base of our kernel config
FC_GUEST_CONFIG_URL=https://raw.githubusercontent.com/firecracker-microvm/firecracker/v1.17.0/resources/guest_configs/microvm-kernel-ci-x86_64-6.18.config
FC_GUEST_CONFIG_SHA256=ba22401a0c7292a4c024ebcd10a562d4a1f1bfd2faed671406d3b159c0cf5215

# Linux 6.18 LTS (the hosted VMs run 6.18.56); checksum from cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc
KERNEL_VERSION=6.18.62
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.62.tar.xz
KERNEL_SHA256=490a7aedf1b355c565d3a6c05333ccccb5da82064eca46b590448a7099d7d651

# Sysbox 0.7.1: the same package and checksum as dispatcher/src/snapshot/config.ts (golden snapshot)
SYSBOX_VERSION=0.7.1
SYSBOX_URL=https://github.com/nestybox/sysbox/releases/download/v0.7.1/sysbox-ce_0.7.1.linux_amd64.deb
SYSBOX_SHA256=9d6d5484f980d0a17f86c492c1262015c2afb66280bdb97215b79fde6a0261c5

# Guest user space: Ubuntu Base 26.04.1 (the hosted golden snapshot's base image is 26.04.1); checksum from cdimage.ubuntu.com SHA256SUMS
UBUNTU_BASE_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/26.04/release/ubuntu-base-26.04.1-base-amd64.tar.gz
UBUNTU_BASE_SHA256=a496a960472ce474a59590b8987d3a1135d3cbef1991f3b1abe8cacfea8bf85a

# Docker 29.1.3 (the golden snapshot's pinned version) as the static bundle: dockerd, containerd, runc, in the guest and on the host for the base disk
DOCKER_VERSION=29.1.3
DOCKER_URL=https://download.docker.com/linux/static/stable/x86_64/docker-29.1.3.tgz
DOCKER_SHA256=c019c608ba2bb009dd673f3230e4d743f36a78d36166c6c2444c05d0aa9ff0d9

# moby's check-config.sh at the commit of tag docker-v29.1.3: lists the kernel options Docker wants
CHECK_CONFIG_URL=https://raw.githubusercontent.com/moby/moby/fbf3ed25f893e6ce21336f1101590e40a13934f4/contrib/check-config.sh
CHECK_CONFIG_SHA256=3ec868d650d91b54e4b6e070966afde03a9ac6463982b4eb83ebd0dc47c7bd62

# Images preloaded into the base Docker disk (by digest, from the public mirror of Docker's official images)
IMG_BUSYBOX=public.ecr.aws/docker/library/busybox@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
IMG_HELLO=public.ecr.aws/docker/library/hello-world@sha256:5e22040d441e5fb3aed38368acbe8486b575d7018df38dbdfbc7311fbb2ef3a9
IMG_DIND=public.ecr.aws/docker/library/docker@sha256:173f284a4299164772a90f52b373e73e087583c0963f1334c9995f190ef6f3f5
