# What the program tarball of the Factory-Runner (#1002) is made of besides this repository, pinned by version AND sha256: the build refuses a
# file with another checksum. Firecracker is pinned in docker/vm/pins.env (one pin for the VM artifacts' smoke boot and for the program that
# ships it); the Python packages are pinned by runner/uv.lock (version and the sha256 of every wheel), read by build_program.py.
# The checksum was compared with the publisher's own SHA256SUMS of the release on 2026-11-11.

# A standalone CPython (astral-sh/python-build-standalone, `install_only_stripped`, x86_64, glibc 2.17 or newer): the machine needs no Python.
PYTHON_VERSION=3.13.14
PYTHON_BUILD_TAG=20260610
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260610/cpython-3.13.14%2B20260610-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_SHA256=d607e18e83227a0527cf3f54a48be973a75358a6885e4be67d4b0359b6f1c880
