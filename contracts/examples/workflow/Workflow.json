{
  "version": 1,
  "name": "Issue to PR",
  "description": "Implement the ticket, have it reviewed, fix until the review finds nothing (3 rounds at most), then open the pull request; otherwise comment on the ticket. A label starts it, or a person by hand: the manual trigger puts the label on first, so both arrive at the same context.",
  "triggers": [
    {
      "id": "labeled",
      "kind": "ticket.labeled",
      "label": "agent implement",
      "steps": []
    },
    {
      "id": "manual",
      "kind": "manual",
      "input": {
        "type": "object",
        "required": ["ticket"],
        "properties": {
          "ticket": {
            "type": "ticket",
            "description": "The ticket to implement, like github:owner/repo#128."
          }
        }
      },
      "steps": [
        {
          "id": "mark",
          "kind": "action",
          "connector": "ticket.labels",
          "ticket": "{{trigger.ticket}}",
          "add": ["agent implement"]
        }
      ]
    }
  ],
  "budgetUsd": 20,
  "steps": [
    {
      "id": "start",
      "kind": "action",
      "connector": "ticket.labels",
      "ticket": "{{trigger.ticket}}",
      "remove": ["agent implement"],
      "add": ["agent working"]
    },
    {
      "id": "fix",
      "kind": "loop",
      "maxRounds": 3,
      "body": [
        {
          "id": "implement",
          "kind": "agent",
          "profile": "implementer@1",
          "environment": "node",
          "session": {
            "continue": "implement"
          },
          "instruction": {
            "first": "{{trigger.ticket.title}}\n\n{{trigger.ticket.body}}",
            "next": "Fix these review findings:\n{{previous.review.findings}}"
          },
          "result": {
            "type": "object",
            "required": ["summary"],
            "properties": {
              "summary": {
                "type": "string",
                "description": "What was done, for the pull request."
              }
            }
          }
        },
        {
          "id": "review",
          "kind": "agent",
          "profile": "reviewer@1",
          "environment": "node",
          "session": "new",
          "branch": "{{implement.branch}}",
          "instruction": "Review branch {{implement.branch}} against this issue. Do not change anything.\n\nIssue: {{trigger.ticket.title}}\n\n{{trigger.ticket.body}}\n\nWhat the implementer reports it did. It names the answers people gave to its questions; those answers are binding, so do not report them as findings:\n{{implement.summary}}",
          "result": {
            "type": "object",
            "required": ["findings"],
            "properties": {
              "findings": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["type", "name", "description"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["bug", "risk", "nit"]
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "until": {
        "empty": "{{review.findings}}"
      }
    },
    {
      "id": "done",
      "kind": "if",
      "when": {
        "equals": ["{{fix.exit}}", "until"]
      },
      "then": [
        {
          "id": "pr",
          "kind": "action",
          "connector": "github.pullRequest.open",
          "head": "{{implement.branch}}",
          "title": "{{trigger.ticket.title}}",
          "body": "{{implement.summary}}\n\nCloses #{{trigger.ticket.number}}"
        }
      ],
      "else": [
        {
          "id": "stuck",
          "kind": "action",
          "connector": "ticket.comment",
          "ticket": "{{trigger.ticket}}",
          "body": "Stopped after {{fix.rounds}} rounds. Open findings:\n{{review.findings}}"
        }
      ]
    }
  ],
  "onFailure": [
    {
      "id": "report",
      "kind": "action",
      "connector": "ticket.comment",
      "ticket": "{{trigger.ticket}}",
      "body": "The agent stopped before a pull request was ready ({{failure.status}} at step {{failure.stepId}}, {{failure.code}}): {{failure.message}}"
    },
    {
      "id": "release",
      "kind": "action",
      "connector": "ticket.labels",
      "ticket": "{{trigger.ticket}}",
      "remove": ["agent working"],
      "add": ["agent failed"]
    }
  ]
}
