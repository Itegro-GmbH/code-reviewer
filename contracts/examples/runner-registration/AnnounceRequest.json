{
  "labels": ["linux", "gpu"],
  "baseVersion": "1.0.1",
  "manifest": {
    "harnesses": [
      { "harness": "opencode", "version": "1.19.0", "auth": "app-key" },
      {
        "harness": "claude-code",
        "version": "2.1.311",
        "auth": "subscription",
        "models": ["haiku", "opus", "sonnet"]
      }
    ],
    "capabilities": []
  },
  "limits": {
    "parallelRuns": 1
  },
  "delivery": {
    "mode": "webhook",
    "url": "https://dispatcher.example.com/dispatch"
  }
}
